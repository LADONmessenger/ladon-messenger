    "Guard": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Guard"
          }
        }
      }
    },
    "HKDF (HMAC-based Key Derivation Function) generates cryptographically strong keys from shared secrets. Each conversation derives unique encryption keys.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HKDF (HMAC-basierte Schlüsselableitung) erzeugt kryptografisch starke Schlüssel aus gemeinsamen Geheimnissen. Jede Unterhaltung leitet eigene Verschlüsselungsschlüssel ab."
          }
        }
      }
    },
    "Have you compared the safety numbers above with your contact in person or through a trusted channel? Only mark as verified if the numbers match exactly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hast du die obigen Sicherheitsnummern persönlich oder über einen vertrauenswürdigen Kanal mit deinem Kontakt verglichen? Markiere nur als verifiziert, wenn die Nummern exakt übereinstimmen."
          }
        }
      }
    },
    "Hides real communication patterns": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbirgt echte Kommunikationsmuster"
          }
        }
      }
    },
