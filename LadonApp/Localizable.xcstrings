    },
    "You took a screenshot of your key material. Delete it from your photo library immediately.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast einen Screenshot deines Schlüsselmaterials gemacht. Lösche ihn sofort aus deiner Fotobibliothek."
          }
        }
      }
    },
    "You were invited to LADON messenger. Add the person, then send your code back so you can both message.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wurdest zu LADON messenger eingeladen. Füge die Person hinzu und schick deinen Code zurück, damit ihr beide schreiben könnt."
          }
        }
      }
    },
    "You'll compare the safety number after connecting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vergleichst die Sicherheitsnummer nach dem Verbinden."
          }
