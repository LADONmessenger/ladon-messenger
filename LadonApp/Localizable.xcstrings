    " icon in any chat to verify.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "-Symbol in einem Chat, um zu verifizieren."
          }
        }
      }
    },
    "%@": {
      "comment": "A badge indicating the number of unread messages. The argument is the number of unread messages.",
      "isCommentAutoGenerated": true
    },
    "%@ (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ added": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hinzugefügt"
          }
        }
      }
    },
    "%@%%": {
      "comment": "A label showing the percentage of the progress ring that is filled. The argument is the percentage, as a whole number.",
      "isCommentAutoGenerated": true
    },
    "%@d": {},
    "%@h": {},
