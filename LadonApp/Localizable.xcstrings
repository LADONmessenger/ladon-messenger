      }
    },
    "Screenshots of this conversation are not permitted. This action has been logged for security purposes.\n\nLADON messenger enforces maximum privacy - sensitive messages should never be captured or shared.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmfotos dieser Unterhaltung sind nicht zulässig. Der Vorgang wurde aus Sicherheitsgründen protokolliert.\n\nLADON messenger setzt auf höchstmöglichen Schutz — vertrauliche Nachrichten sollten nie aufgezeichnet oder weitergegeben werden."
          }
        }
      }
    },
