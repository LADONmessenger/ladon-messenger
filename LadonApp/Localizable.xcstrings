      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzugefügt"
          }
        }
      }
    },
    "Added remotely — compare the safety number to be sure it's really them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus der Ferne hinzugefügt — vergleicht die Sicherheitsnummer, um sicherzugehen, dass es wirklich sie sind."
          }
        }
      }
    },
    "Advanced Security": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweiterte Sicherheit"
          }
        }
      }
    },
    "Advanced security features protect your conversations at every level.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweiterte Sicherheitsfunktionen schützen deine Unterhaltungen auf jeder Ebene."
          }
        }
      }
    },
    "All app traffic is routed through the Tor network. Our servers and the people you write to never see your IP address.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gesamte Datenverkehr der App läuft über das Tor-Netzwerk. Unsere Server und die Menschen, denen du schreibst, sehen deine IP-Adresse nie."
          }
        }
      }
    },
    "All encryption keys and conversations will be PERMANENTLY destroyed. This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Verschlüsselungsschlüssel und Unterhaltungen werden DAUERHAFT zerstört. Dies kann nicht rückgängig gemacht werden."
          }
        }
      }
    },
    "All traffic is routed through the Tor network. Your IP address and location are never exposed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gesamte Datenverkehr wird über das Tor-Netzwerk geleitet. Deine IP-Adresse und dein Standort werden nie preisgegeben."
          }
        }
      }
    },
    "All traffic routed through Tor network": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamter Datenverkehr über Tor-Netzwerk geleitet"
          }
        }
      }
    },
