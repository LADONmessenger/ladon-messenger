    "Double Ratchet continuously generates new keys. Even if your device is compromised, past messages stay encrypted — the keys that could open them no longer exist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Double Ratchet erzeugt fortlaufend neue Schlüssel. Selbst wenn dein Gerät kompromittiert wird, bleiben vergangene Nachrichten verschlüsselt — die Schlüssel, mit denen sie sich öffnen liessen, existieren nicht mehr."
          }
        }
      }
    },
