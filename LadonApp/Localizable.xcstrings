      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du"
          }
        }
      }
    },
    "You both confirm each other — scan their QR code to reply.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr bestätigt euch gegenseitig — scanne ihren QR-Code, um zu antworten."
