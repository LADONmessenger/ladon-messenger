    "ChaCha20-Poly1305 AEAD cipher provides authenticated encryption. Military-grade 256-bit security with built-in message authentication to detect tampering.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ChaCha20-Poly1305 AEAD-Verschlüsselung bietet authentifizierte Verschlüsselung. Militärische 256-Bit-Sicherheit mit integrierter Nachrichtenauthentifizierung zur Erkennung von Manipulationen."
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        }
      }
    },
