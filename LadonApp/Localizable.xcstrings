    "Dilithium3 post-quantum signatures verify message authenticity. Each message is cryptographically signed to prevent tampering and impersonation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilithium3 Post-Quanten-Signaturen verifizieren die Nachrichtenauthentizität. Jede Nachricht wird kryptographisch signiert, um Manipulation und Identitätsdiebstahl zu verhindern."
          }
        }
      }
    },
    "Disable Apple Push Notifications": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
