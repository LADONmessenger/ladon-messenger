      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code gescannt"
          }
        }
      }
    },
    "Compare Safety Numbers to ensure no one is intercepting your messages.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche Sicherheitsnummern, um sicherzustellen, dass niemand deine Nachrichten abfängt."
          }
        }
      }
    },
    "Compare the safety number with them to be sure it's really them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche die Sicherheitsnummer mit der Person, um sicherzugehen, dass sie es wirklich ist."
