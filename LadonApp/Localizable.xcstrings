    "Screen recording is not permitted while LADON messenger is active. This constitutes a severe security violation.\n\nPlease disable screen recording immediately.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmaufnahmen sind nicht zulässig, solange LADON messenger aktiv ist. Das ist ein schwerwiegender Sicherheitsverstoss.\n\nBitte beende die Aufnahme umgehend."
          }
        }
      }
    },
    "Screenshot blocked": {
      "localizations": {
