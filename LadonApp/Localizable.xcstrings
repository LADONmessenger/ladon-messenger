      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "APNs-Umgebung"
          }
        }
      }
    },
    "About": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über"
          }
        }
      }
    },
    "Active — your IP is hidden": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv — deine IP ist verborgen"
          }
        }
      }
    },
    "Add Contact": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontakt hinzufügen"
          }
        }
      }
    },
    "Add a name so you can recognise this contact.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergib einen Namen, damit du diesen Kontakt wiedererkennst."
          }
        }
      }
    },
    "Add contact": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontakt hinzufügen"
          }
        }
      }
    },
    "Add me on LADON messenger — open the app, tap +, choose \"Enter a key manually\" and paste this:\n\n%@": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge mich bei LADON messenger hinzu — öffne die App, tippe auf +, wähle „Schlüssel manuell eingeben“ und füge das hier ein:\n\n%@"
          }
        }
      }
    },
    "Add me on LADON messenger — tap to connect:\n%@\n\nNo app yet? Get LADON messenger, then add this code under +  →  Add remotely:\n%@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge mich bei LADON messenger hinzu — tippe zum Verbinden:\n%@\n\nNoch keine App? Hol dir LADON messenger und füge diesen Code unter +  →  Aus der Ferne hinzufügen ein:\n%@"
          }
        }
      }
    },
    "Add remotely": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus der Ferne hinzufügen"
          }
        }
      }
    },
    "Add someone to chat": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemanden hinzufügen"
          }
        }
      }
    },
