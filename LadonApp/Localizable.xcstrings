    "Kyber768 + Dilithium3 (NIST)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kyber768 + Dilithium3 (NIST)"
          }
        }
      }
    },
    "Kyber768 and Dilithium3 are NIST-standardized post-quantum algorithms. Your messages are protected against both current and future quantum computer attacks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kyber768 und Dilithium3 sind NIST-standardisierte Post-Quanten-Algorithmen. Deine Nachrichten sind sowohl gegen heutige als auch zukünftige Angriffe durch Quantencomputer geschützt."
          }
        }
      }
    },
    "LADON messenger": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LADON messenger"
          }
        }
      }
    },
    "LADON messenger is free, and its code is public. Anyone can check what the app does. The servers your messages travel through cost money every month, and right now I pay for them myself. If LADON messenger helps you, a tip keeps it running.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LADON messenger ist kostenlos, und der Code ist öffentlich. Jede und jeder kann nachprüfen, was die App tut. Die Server, über die deine Nachrichten laufen, kosten jeden Monat Geld, und im Moment zahle ich sie selbst. Wenn dir LADON messenger hilft, hält ein Trinkgeld ihn am Laufen."
          }
        }
      }
    },
