    "Signal Protocol with Double Ratchet algorithm. Every message uses a unique encryption key that is automatically deleted after use, ensuring perfect forward secrecy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signal-Protokoll mit Double-Ratchet-Algorithmus. Jede Nachricht verwendet einen einzigartigen Verschlüsselungsschlüssel, der nach Gebrauch automatisch gelöscht wird, was perfekte Vorwärtsgeheimnis gewährleistet."
          }
        }
      }
    },
    "Skip": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überspringen"
