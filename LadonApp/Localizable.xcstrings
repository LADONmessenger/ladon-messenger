    "Establishing secure connection… %@%%": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere Verbindung wird aufgebaut … %@%%"
          }
        }
      }
    },
    "Every message gets a fresh key. Each time the conversation turns around, the whole key chain is renewed — and every 32nd turn adds a new post-quantum key on top. Nothing here needs your attention.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Nachricht bekommt einen frischen Schlüssel. Bei jedem Hin und Her wird die gesamte Schlüsselkette erneuert — und jeder 32. Wechsel legt zusätzlich einen neuen Post-Quanten-Schlüssel darüber. Hier musst du nichts tun."
          }
        }
      }
    },
    "Exit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit"
          }
        }
      }
    },
    "Face ID / Touch ID required. Please enable biometric authentication in Settings.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID / Touch ID erforderlich. Bitte aktiviere die biometrische Authentifizierung in den Einstellungen."
          }
        }
      }
    },
    "For security reasons, screenshots of chat conversations and sensitive information are not possible.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Sicherheitsgründen sind Screenshots von Chat-Unterhaltungen und sensiblen Informationen nicht möglich."
          }
        }
      }
    },
    "For security, all encryption keys and conversations will be PERMANENTLY DESTROYED in:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Sicherheitsgründen werden alle Verschlüsselungsschlüssel und Unterhaltungen DAUERHAFT ZERSTÖRT in:"
          }
        }
      }
    },
    "For security, content is hidden during screen recording or mirroring": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Sicherheitsgründen werden Inhalte bei Bildschirmaufnahme oder Spiegelung ausgeblendet"
