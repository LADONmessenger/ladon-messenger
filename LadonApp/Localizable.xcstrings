    "This contact can no longer send you messages. Your other contacts receive your new key automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kontakt kann dir dann keine Nachrichten mehr senden. Deine anderen Kontakte erhalten deinen neuen Schlüssel automatisch."
