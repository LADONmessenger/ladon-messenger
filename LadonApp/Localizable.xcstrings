            "value": "Timer"
          }
        }
      }
    },
    "To be sure you're talking to the right person — not an impostor — compare the safety number with them. You can also do this any time from the chat.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit du sicher bist, mit der richtigen Person zu sprechen — und nicht mit einem Betrüger — vergleicht die Sicherheitsnummer miteinander. Du kannst das jederzeit auch im Chat tun."
          }
        }
      }
    },
